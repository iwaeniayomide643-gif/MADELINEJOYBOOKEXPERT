<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="1200" height="675">
  <defs>
    <linearGradient id="campBg_autumn-atelier-thumb" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#240a1a"/>
      <stop offset="100%" stop-color="#08030b"/>
    </linearGradient>
    <radialGradient id="campGlow_autumn-atelier-thumb" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f472b6" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#f472b6" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#campBg_autumn-atelier-thumb)"/>
  <rect width="100%" height="100%" fill="url(#campGlow_autumn-atelier-thumb)"/>
  
  <!-- Film Letterbox Bars -->
  <rect x="0" y="0" width="1200" height="40" fill="#000000" fill-opacity="0.7"/>
  <rect x="0" y="635" width="1200" height="40" fill="#000000" fill-opacity="0.7"/>
  
  <!-- Play Button Center Icon -->
  <circle cx="600" cy="310" r="55" fill="#f472b6" fill-opacity="0.9" stroke="#ffffff" stroke-width="3"/>
  <polygon points="590,285 625,310 590,335" fill="#0d0611"/>
  
  <!-- Lower Title Banner -->
  <rect x="80" y="490" width="1040" height="120" rx="16" fill="#0d0611" fill-opacity="0.8" stroke="#f472b6" stroke-opacity="0.3"/>
  <text x="120" y="540" font-family="'Playfair Display', serif" font-size="32" font-weight="700" fill="#ffffff">The Autumn Atelier</text>
  <text x="120" y="580" font-family="'DM Sans', sans-serif" font-size="14" font-weight="600" fill="#f472b6" letter-spacing="0.15em" text-transform="uppercase">OFFICIAL BOOK TRAILER • BY CAMILLE LAURENT</text>
  
  <!-- Duration Badge -->
  <rect x="1000" y="535" width="90" height="34" rx="8" fill="#1e1226" stroke="#f472b6" stroke-width="1.5"/>
  <text x="1045" y="558" font-family="'DM Sans', sans-serif" font-size="14" font-weight="700" fill="#ffffff" text-anchor="middle">0:56</text>
</svg>